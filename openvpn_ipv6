#!/bin/sh

# OpenVPN IPv6地址自动更新脚本
# 配置文件路径
CONFIG_FILE="/etc/config/openvpn"
# myvpn  要和配置文件一样名称
OPENVPN_SECTION="myvpn"
LOG_FILE="/var/log/openvpn_ipv6.log"
MAX_LOG_LINES=20

# 优化的日志函数
log_message() {
    local message="$(date '+%Y-%m-%d %H:%M:%S') - $1"
    local temp_file="${LOG_FILE}.tmp"
    
    # 如果日志文件存在且行数超过限制，保留最新的(MAX_LOG_LINES-1)行
    if [ -f "$LOG_FILE" ]; then
        tail -n $((MAX_LOG_LINES - 1)) "$LOG_FILE" > "$temp_file" 2>/dev/null
    fi
    
    # 添加新日志
    echo "$message" >> "$temp_file"
    
    # 替换原日志文件
    mv "$temp_file" "$LOG_FILE" 2>/dev/null || true
}

# 获取当前IPv6地址
get_current_ipv6() {
    ip -6 addr show dev pppoe-wan 2>/dev/null | grep -E 'inet6.*global' | awk '{print $2}' | cut -d'/' -f1 | head -1
}

# 获取配置的IPv6地址
get_configured_ipv6() {
    uci -q get openvpn.$OPENVPN_SECTION.local 2>/dev/null
}

# 主逻辑
main() {
    log_message "开始IPv6地址检查"
    
    current_ipv6=$(get_current_ipv6)
    configured_ipv6=$(get_configured_ipv6)
    
    if [ -z "$current_ipv6" ]; then
        log_message "错误: 无法获取IPv6地址"
        exit 1
    fi
    
    if [ -z "$configured_ipv6" ]; then
        log_message "警告: 配置中无IPv6地址，设置为: $current_ipv6"
        uci set openvpn.$OPENVPN_SECTION.local="$current_ipv6"
        uci commit openvpn
        /etc/init.d/openvpn restart
        log_message "OpenVPN已重启"
    elif [ "$current_ipv6" != "$configured_ipv6" ]; then
        log_message "地址变更: $configured_ipv6 -> $current_ipv6"
        uci set openvpn.$OPENVPN_SECTION.local="$current_ipv6"
        uci commit openvpn
        /etc/init.d/openvpn restart
        log_message "OpenVPN已重启"
    else
        log_message "地址一致，无需更新"
    fi
}

main
